# Groq LLM — reasoning brain: picks sources, dedups, writes the summary
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# How many results to pull from each external source per query
MAX_RESULTS_PER_SOURCE=5

# Timeout for fetching an individual page (seconds)
REQUEST_TIMEOUT_SECONDS=10

# Where past searches are remembered (simple local JSON file — no DB required)
HISTORY_FILE=./data/search_history.json

# Where exported Markdown/PDF summaries are written
OUTPUT_DIR=./outputs
